#!/bin/zsh
# lean-sem <mode> <path> [tag]
#   mode = check : run `lean <path>` (path relative to ~/riemann/pilot)
#   mode = build : run `lake build <module>`
# At most 3 concurrent Lean processes (slot dirs), waits while free memory < 25%.
ulimit -n 65536
export PATH=$HOME/.elan/bin:/opt/homebrew/bin:$PATH
cd ~/riemann/pilot || exit 2
mode=$1; target=$2; tag=${3:-none}
SLOTS=/tmp/rh-pilot-slots; mkdir -p $SLOTS
slot=""
while [ -z "$slot" ]; do
  for i in 1 2 3; do
    if [ -d $SLOTS/s$i ]; then
      p=$(cat $SLOTS/s$i/pid 2>/dev/null)
      if [ -n "$p" ] && ! kill -0 $p 2>/dev/null; then rm -rf $SLOTS/s$i; fi
    fi
    if mkdir $SLOTS/s$i 2>/dev/null; then echo $$ > $SLOTS/s$i/pid; slot=$i; break; fi
  done
  [ -z "$slot" ] && sleep 2
done
trap "rm -rf $SLOTS/s$slot" EXIT INT TERM
waited=0
while true; do
  free=$(memory_pressure 2>/dev/null | awk "/free percentage/{gsub(\"%\",\"\",\$5); print \$5}")
  [ -z "$free" ] && break
  [ "$free" -ge 25 ] && break
  sleep 10; waited=$((waited+10))
done
if [ ! -f .leanpath ] || [ lakefile.toml -nt .leanpath ]; then lake env printenv LEAN_PATH > .leanpath; fi
export LEAN_PATH=$(cat .leanpath)
LEAN=$HOME/.elan/toolchains/leanprover--lean4---v4.36.0/bin/lean
tf=$(mktemp /tmp/rh-pilot-time.XXXXXX)
t0=$(perl -MTime::HiRes=time -e "printf q(%.3f), time")
if [ "$mode" = build ]; then
  /usr/bin/time -l -o $tf perl -e "alarm 900; exec @ARGV" nice -n 10 lake build "$target" 2>&1
else
  /usr/bin/time -l -o $tf perl -e "alarm 600; exec @ARGV" nice -n 10 $LEAN "$target" 2>&1
fi
code=$?
t1=$(perl -MTime::HiRes=time -e "printf q(%.3f), time")
rss=$(awk "/maximum resident set size/{print \$1}" $tf); rm -f $tf
wall=$(perl -e "printf q(%.2f), $t1-$t0")
echo "{\"ts\":$t0,\"mode\":\"$mode\",\"target\":\"$target\",\"tag\":\"$tag\",\"wall_s\":$wall,\"rss\":${rss:-0},\"exit\":$code,\"slot\":$slot,\"mem_wait_s\":$waited}" >> logs/lean-checks.jsonl
echo "LEANCHECK exit=$code wall_s=$wall rss_mb=$(( ${rss:-0} / 1048576 ))"
exit $code
